# Copy this file to .env (same folder) and fill in your values.
# .env is gitignored; never commit real credentials.
# Settings marked "optional" have a default in application.yml and can be removed.

# ============================================================
# PostgreSQL Database (required)
# ============================================================
# For a local database, `docker compose -f docker-compose.dev.yml up -d` creates one
# with exactly these values.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
# Schema for all application tables. Flyway creates it on first start if it does not exist.
DB_SCHEMA=example_schema

# ============================================================
# Application URLs & CORS (optional)
# ============================================================
# Public base URL of this backend, available to code as app.base-url. Default: http://localhost:8000
APP_BASE_URL=http://localhost:8000
# Comma-separated frontend origins allowed to call the API. Patterns like https://*.example.com work.
# Default: http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================================
# Authentication
# ============================================================
# Login methods; use one or both. Read once at startup.
#   JWT_ENABLED       email/password login; the app issues its own access and refresh tokens
#   FIREBASE_ENABLED  login with Firebase ID tokens (needs firebase-service-account.json and BUCKET_NAME)
# With both enabled, a Firebase login also returns the app's tokens and protected endpoints accept either.
# A disabled method's login endpoints answer 503. Optional, both default to true.
JWT_ENABLED=true
FIREBASE_ENABLED=true
# Base64, min 256 bits: openssl rand -base64 48
# Signs the app's access tokens. Required when JWT_ENABLED=true: the app refuses to start without a valid one,
# and there is no fallback secret in application.yml.
# Use a different secret for every project and environment, and never commit a real one.
JWT_SECRET=your_base64_secret_here
# Token lifetimes in milliseconds. Optional, defaults 900000 (15 minutes) and 604800000 (7 days).
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ============================================================
# Uploads & Storage (Firebase)
# ============================================================
# Max avatar size in bytes. Optional, default 5242880 (5 MB).
AVATAR_MAX_SIZE=5242880
# Comma-separated MIME types accepted for avatars. Optional, default image/jpeg,image/png,image/webp
AVATAR_ALLOWED_FORMATS=image/jpeg,image/png,image/webp
# Max size of any uploaded file or multipart request, in bytes. Optional, default 20971520 (20 MB).
MAX_UPLOAD_SIZE=20971520

# Path of the Firebase service account key. Optional, default firebase-service-account.json
# (relative to the working directory; in Docker it is mounted at /app).
# FIREBASE_CONFIG_PATH=firebase-service-account.json
# Standard Google variable pointing at the key inside the Docker container. Not read by the app itself.
GOOGLE_APPLICATION_CREDENTIALS=/app/firebase-service-account.json
# Firebase Storage bucket, without gs:// (Firebase Console > Storage). Required when Firebase is enabled.
# Newer projects: <project-id>.firebasestorage.app, older: <project-id>.appspot.com
BUCKET_NAME=your-project-id.firebasestorage.app
# Base for public file URLs: <FIREBASE_URL><BUCKET_NAME>/o/<file>?alt=media
# Optional, default https://firebasestorage.googleapis.com/v0/b/
FIREBASE_URL=https://firebasestorage.googleapis.com/v0/b/

# ============================================================
# Formatting (optional)
# ============================================================
# Java date pattern for the user's join date in API responses. Default: yyyy-MM-dd
USER_JOIN_DATE_FORMAT=yyyy-MM-dd
